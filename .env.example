# ==============================================================================
# FRIDAY AI Assistant — Environment Variables
# Copy this file to .env and fill in the values before starting.
# ==============================================================================

# Telegram Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Your personal numeric Telegram User ID (get it from @userinfobot on Telegram)
# ONLY this user will be permitted to chat with FRIDAY.
TELEGRAM_ALLOWED_USER_ID="123456789"

# AI Model Configuration
# gemini (recommended) or openai
DEFAULT_LLM_PROVIDER="gemini"

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy..."

# OpenAI API Key (Optional — only if DEFAULT_LLM_PROVIDER="openai")
OPENAI_API_KEY=""

# Tavily AI Search API Key (Get from https://tavily.com)
TAVILY_API_KEY="tvly-..."

# Supabase Configuration (Get from Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Personalization Settings
USER_TIMEZONE="Asia/Kolkata"
USER_NAME="Boss"
BRIEFING_TIME="07:00"

# Deployment Configuration (Optional)
# Leave empty for Long Polling mode (recommended for local dev and Railway workers)
# Provide your Railway public URL if using Webhook mode (e.g., https://your-app.up.railway.app)
WEBHOOK_URL=""
# Required when WEBHOOK_URL is set; use a random value of at least 16 characters.
TELEGRAM_WEBHOOK_SECRET=""
WEBHOOK_PORT="3000"
HEALTH_PORT="8080"

# Node Environment
NODE_ENV="development"
